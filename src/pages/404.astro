---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found — Champagne.dev">
  <section class="wrap journal-page nf">
    <div class="nf-copy">
      <span class="nf-code">Error 404</span>
      <h1>Wrong <em>turn.</em></h1>
      <p class="hero-lede">This page doesn’t exist, or it moved. Head back and take the scenic route.</p>
      <a class="original-link nf-back" href="/">Back to the good stuff <span aria-hidden="true">↗</span></a>
    </div>
    <div class="nf-sign">
      <div class="nf-post">
        <picture class="nf-pole" aria-hidden="true">
          <source srcset="/assets/caution-sign-post.webp" type="image/webp" />
          <img src="/assets/caution-sign-post.png" alt="" width="120" height="1320" />
        </picture>
        <button type="button" class="nf-face" aria-label="Push the Proceed With Caution sign">
          <picture>
            <source srcset="/assets/caution-sign-face.webp" type="image/webp" />
            <img src="/assets/caution-sign-face.png" alt="A yellow diamond road sign reading Proceed With Caution, on a metal post" width="707" height="716" />
          </picture>
        </button>
      </div>
    </div>
  </section>
</Base>

<style>
.nf{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,.75fr);gap:56px;align-items:end;min-height:calc(100dvh - 80px);padding-block:120px 0;box-sizing:border-box}
.nf-copy{align-self:center}
.nf h1{font:400 clamp(72px,9vw,140px)/.92 var(--serif);letter-spacing:-.03em;margin:0;text-wrap:balance}
.nf h1 em{font-style:italic}
.nf .hero-lede{margin:28px 0 32px;font:italic 400 clamp(20px,2vw,24px)/1.38 Newsreader,Georgia,serif;color:var(--ink);max-width:34ch}
/* Same treatment as the contact links: serif text, dotted underline, small sans arrow. */
.nf-back{font-size:clamp(24px,2.4vw,30px);color:var(--ink)}
.nf-back > span{font:400 .6em var(--sans,system-ui);vertical-align:.3em;margin-left:.1em}
/* Status code on a strip of label tape, like the "Carbone NYC" label on the About photo. */
.nf-code{display:inline-block;margin:0 0 26px 4px;padding:8px 16px 7px;background:#1f2f1a;color:#eef2ea;border-radius:2px;font:700 13px/1 var(--sans,Inter,system-ui,sans-serif);letter-spacing:.22em;text-transform:uppercase;transform:rotate(-3deg);text-shadow:0 1px 0 rgb(0 0 0 / .45),0 -1px 0 rgb(255 255 255 / .18);filter:drop-shadow(0 2px 3px rgb(45 35 15 / .25))}

/* The post rises out of the bottom of the page and stays put; the sign face turns on it in 3D.
   Layer positions come from the original 707x1400 photo: the face is its top 716px, the post a 120px strip from x 300, y 80. */
.nf-sign{display:grid;justify-items:center;align-self:end;filter:drop-shadow(0 3px 2px rgb(40 32 20 / .2)) drop-shadow(14px 20px 22px rgb(40 32 20 / .16))}
.nf-post{position:relative;height:min(640px,72vh);aspect-ratio:707/1400;perspective:1100px}
.nf-pole{position:absolute;left:42.43%;top:5.71%;width:16.97%;height:94.29%;-webkit-mask-image:linear-gradient(#000 78%,transparent);mask-image:linear-gradient(#000 78%,transparent)}
.nf-pole img,.nf-face img{display:block;width:100%;height:100%}
.nf-face{--a:0deg;--lit:1;position:absolute;inset:0 0 auto;height:51.14%;padding:0;border:0;background:none;cursor:pointer;transform-origin:50.57% 50%;transform:rotateY(var(--a));filter:brightness(var(--lit));will-change:transform}
.nf-face:focus-visible{outline:2px solid var(--ink);outline-offset:8px}

/* Stacked: centered, with room for the taller wrapped header (104px under 768px wide) so the label isn't hidden. */
@media(max-width:820px){.nf{grid-template-columns:1fr;gap:24px;padding-top:150px;text-align:center}.nf .hero-lede{margin-inline:auto}.nf-post{height:380px}}
</style>

<script>
  // Push the sign: the side you click swings away, then a damped spring brings it back around the post.
  const face = document.querySelector<HTMLButtonElement>('.nf-face');
  const post = face?.parentElement;
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  let angle = 0, velocity = 0, last = 0, frame = 0;
  const render = () => {
    const tilt = Math.abs(Math.sin(angle * Math.PI / 180));
    face!.style.setProperty('--a', `${angle.toFixed(2)}deg`);
    face!.style.setProperty('--lit', (1 - tilt * 0.3).toFixed(3)); // the face darkens as it turns from the light
  };
  const step = (now: number) => {
    const dt = Math.min((now - last) / 1000, 1 / 30); last = now;
    velocity += (-62 * angle - 3.4 * velocity) * dt; // stiffness, damping
    angle = Math.max(-72, Math.min(72, angle + velocity * dt));
    render();
    if (Math.abs(angle) > 0.05 || Math.abs(velocity) > 0.5) frame = requestAnimationFrame(step);
    else { angle = velocity = 0; render(); frame = 0; }
  };
  const push = (side: number) => {
    velocity += side * 340;
    if (!frame) { last = performance.now(); frame = requestAnimationFrame(step); }
  };
  // On arrival the sign swings both ways once, like it was just knocked, then settles.
  if (face && !still.matches) setTimeout(() => push(0.85), 350);
  face?.addEventListener('click', event => {
    if (still.matches || !post) return;
    const box = post.getBoundingClientRect();
    const axis = box.left + box.width * 0.5057;
    // Where on the face you pushed, from -1 (left edge) to 1 (right edge); keyboard presses push the left side.
    const side = event.detail === 0 ? -0.7 : Math.max(-1, Math.min(1, (event.clientX - axis) / (box.width / 2)));
    push(side);
  });
</script>
