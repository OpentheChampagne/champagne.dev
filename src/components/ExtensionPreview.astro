---
import PackageTrackPreview from './PackageTrackPreview.astro';
const { kind } = Astro.props;
const shortcuts = [
  ['🔭', 'Watch this page', 'Monitor this page for meaningful changes.', 'purple'],
  ['✨', 'Send to Muse', 'Hand Muse this page, then say what you want.', 'blue'],
  ['🔎', 'Research this', 'Investigate this page and go deeper.', 'teal'],
  ['⚡', 'Handle this', 'Figure out the next step and help me do it.', 'orange'],
  ['📋', 'Summarize', 'Get the key points and takeaways.', 'green'],
];
const recipes = ['Improve Writing', 'Explain This', 'Summarize Page', 'Draft Reply', 'Analyze Company/Page'];
---
<!-- Scaled, non-interactive HTML replicas of the local extension popups.
     Labels, structure, spacing and colors follow their source interfaces.
     Sample tab/package data is illustrative; no extension runtime is loaded. -->
<div class:list={['extension-preview', kind]}>
  {kind === 'paste' && <PackageTrackPreview />}
  {kind === 'summary' && <div class="mu-popup">
    <div class="mu-header"><strong>Shortcuts for Muse</strong><span>☷</span></div>
    <div class="mu-source"><strong>Felipe Castillo — Champagne.dev</strong><small>champagne.dev</small></div>
    <div class="mu-cards">{shortcuts.map(([icon, name, description, color], i) => <div class:list={['mu-tile', color]} style={`--n: ${i}`}><span class="mu-icon">{icon}</span><strong>{name}</strong><span>{description}</span></div>)}<div class="mu-new"><span>+</span>New Shortcut</div></div>
  </div>}
  {kind === 'research' && <div class="eg-popup">
    <div class="eg-header">✦ Enhance Gemini</div>
    <div class="eg-input"><span class="eg-ph">What do you need help with?</span><span class="eg-typed">Summarize this page in five bullets</span></div>
    <div class="eg-section"><div class="eg-label">Recipes</div><div class="eg-recipes">{recipes.map((name, i) => <div class:list={['eg-recipe', {'eg-selected': name === 'Summarize Page'}]} style={`--n: ${i}`}>{name}</div>)}</div></div>
    <div class="eg-footer"><span>+ Create Recipe</span><span>Manage</span></div>
  </div>}
</div>
<style>
.extension-preview { flex:none; font:14px/1.4 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; color:#111112; transform:scale(.7); --ui-surface:#fff; --ui-line:#e3e3e8; --ui-muted:#6e6e76; }
.extension-preview * { box-sizing:border-box; }
.extension-preview strong { font-weight:500; }
.paste { width:380px; transform:scale(.7); }

.delivered { --status:#16a34a; }
.summary { width:360px; transform:scale(.61); }
.mu-popup { background:#fcfcfc; border-radius:16px; padding:14px 14px 16px; display:flex; flex-direction:column; gap:12px; --fill:rgba(0,0,0,.05); }
.mu-header { display:flex; justify-content:space-between; align-items:center; padding:0 2px; font-size:15px; height:32px; }
.mu-header > span { color:var(--ui-muted); font-size:23px; }
.mu-source { padding:9px 14px; background:var(--ui-surface); border:1px solid var(--ui-line); border-radius:20px; }
.mu-source strong { display:block; font-size:14px; }
.mu-source small { display:block; font-size:12px; color:var(--ui-muted); margin-top:1px; }
.mu-cards { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }
.mu-tile { display:grid; justify-items:start; align-content:start; gap:2px; padding:12px 28px 13px 12px; border-radius:20px; background:var(--fill); }
.mu-icon { display:grid; place-items:center; width:32px; height:32px; margin-bottom:8px; border-radius:10px; background:linear-gradient(145deg,var(--a),var(--b)); font-size:17px; line-height:1; }
.mu-tile strong { font-size:14px; letter-spacing:-.01em; }
.mu-tile > span:last-child { font-size:12px; line-height:1.35; color:var(--ui-muted); }
.purple { --a:#8b5cf6; --b:#6d3ee8; }.blue { --a:#3b82f6; --b:#2463d8; }.teal { --a:#14b8a6; --b:#0d8f84; }.orange { --a:#fb923c; --b:#ea6a12; }.green { --a:#34c759; --b:#1f9d45; }
.mu-new { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px; border:1px solid var(--ui-line); border-radius:20px; font-weight:500; color:var(--ui-muted); }
.mu-new > span { width:32px; height:32px; border-radius:50%; background:var(--fill); display:grid; place-items:center; font-size:20px; font-weight:400; }
.research { width:380px; transform:scale(.72); color:#211a34; }
.eg-popup { display:flex; flex-direction:column; gap:14px; padding:14px; border-radius:18px; background:#f3f1fb; }
.eg-header { font-size:15px; font-weight:700; }
.eg-input { position:relative; padding:12px 14px; border:1px solid #6c4ce0; border-radius:12px; font-size:14px; background:#fff; color:#777; box-shadow:0 0 0 3px #6c4ce02e; white-space:nowrap; overflow:hidden; }
.eg-typed { position:absolute; left:14px; top:12px; color:#211a34; clip-path:inset(0 100% 0 0); }
.eg-section { display:flex; flex-direction:column; gap:6px; }
.eg-label { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.04em; color:#211a348c; }
.eg-recipes { display:flex; flex-direction:column; gap:4px; }
.eg-recipe { padding:11px 12px; border-radius:10px; background:#fff; font-size:13px; box-shadow:0 1px 2px #1410200a; }
.eg-footer { display:flex; justify-content:space-between; padding-top:6px; border-top:1px solid #211a341a; }
.eg-footer > span { padding:6px 8px; font-size:12px; font-weight:600; color:#6c4ce0; }
@media(prefers-reduced-motion:no-preference) {
 /* Muse: each shortcut is pressed in turn, 1.6s apart, on an 8s loop. */
 .mu-tile { animation:shortcut-press 8s var(--pop) infinite; animation-delay:calc(var(--n) * 1.6s); }
 /* Gemini: a request is typed, then the highlight walks down the recipes. */
 .eg-ph { animation:ph-hide 8s linear infinite; }
 .eg-typed { animation:gemini-type 8s steps(34,end) infinite; }
 .eg-recipe { animation:recipe-walk 8s ease infinite; animation-delay:calc(var(--n) * .7s); }
 .eg-selected { animation:recipe-pick 8s ease infinite; }
 .eg-recipe:nth-child(n+4) { animation:none; } /* the walk stops at Summarize Page */
}
@keyframes shortcut-press { 0%,14%,100% {transform:scale(1); box-shadow:none} 3% {transform:scale(.94); box-shadow:0 0 0 2px var(--a)} 8% {transform:scale(1); box-shadow:0 0 0 2px var(--a)} }
@keyframes ph-hide { 0%,4% {opacity:1} 5%,92% {opacity:0} 100% {opacity:1} }
@keyframes gemini-type { 0%,5% {clip-path:inset(0 100% 0 0)} 30%,92% {clip-path:inset(0)} 100% {clip-path:inset(0 100% 0 0)} }
@keyframes recipe-walk { 0%,34%,44%,100% {background:#fff} 37%,41% {background:#6c4ce014} }
@keyframes recipe-pick { 0%,52%,100% {background:#fff; box-shadow:0 1px 2px #1410200a} 55%,92% {background:#6c4ce01f; box-shadow:inset 0 0 0 1px #6c4ce0} }
@container (max-width: 300px) { .paste { transform:scale(.68); } .research { transform:scale(.65); } }
@container (max-width: 250px) { .paste { transform:scale(.5); } .research { transform:scale(.48); } .summary { transform:scale(.5); } }
</style>
