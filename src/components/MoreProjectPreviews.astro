---
const { kind } = Astro.props;
---
<!-- Non-interactive HTML/CSS preview following the local iCloud Menu popup. Counts are sample data. -->
{kind === 'mail' && <div class="mail-scene">
  <div class="mail-popup">
    <span class="cloud-mark"></span>
    <strong>Hello, Felipe!</strong>
    <span class="mail-status">3 unread messages</span>
    <div class="mail-account"><span class="cloud-mark"></span><span class="mail-count">3</span></div>
    <span class="mail-refresh">Refresh</span>
  </div>
</div>}
<style>
.mail-scene{width:100%;height:100%;display:grid;place-items:center;font:14px/1.4 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
.mail-scene{background:linear-gradient(145deg,#e6f4ff,#c8ddf6)}
.mail-popup{width:210px;padding:22px 12px 16px;display:flex;flex-direction:column;align-items:center;color:#151515;background:rgb(246,241,241);border-radius:15px;box-shadow:0 18px 40px #24477426;border:1px solid #fff9}
.mail-popup>strong{font-size:16px;margin-top:12px}.mail-status{font-size:12px;color:#555;margin-top:4px}
.cloud-mark{display:block;position:relative;width:32px;height:15px;background:linear-gradient(#5dd4ff,#1989f8);border-radius:12px}
.cloud-mark:before,.cloud-mark:after{content:"";position:absolute;background:#5dd4ff;border-radius:50%;width:17px;height:17px;top:-7px;left:5px}.cloud-mark:after{width:12px;height:12px;left:18px;top:-4px}
.mail-account{position:relative;display:grid;place-items:center;width:64px;height:64px;border-radius:15px;background:white;box-shadow:0 4px 8px #0003;margin:28px 0 24px}.mail-account .cloud-mark{transform:scale(1.4)}
.mail-count{position:absolute;right:-10px;top:-10px;background:#ff0000db;color:white;border-radius:999px;min-width:20px;padding:4px 6px;text-align:center;font-size:14px;font-weight:700;line-height:1}
.mail-refresh{background:#d2d2d2;border-radius:8px;padding:7px 10px;font-size:12px}








@media(prefers-reduced-motion:no-preference){.mail-count{animation:mail-pop 6s var(--pop,cubic-bezier(.2,.8,.3,1)) infinite}}
@keyframes mail-pop{0%,12%,100%{transform:scale(0)}24%,90%{transform:scale(1)}}



@media(prefers-color-scheme:dark){.mail-scene{background:#223648}}
</style>
